#!/usr/bin/env bash
# sdd-graph CLI shim.
# Resolves the plugin root from this script's own location (symlink-aware) and
# hands over to the plugin-local tsx runner.
set -euo pipefail

source_path="${BASH_SOURCE[0]}"
while [ -L "$source_path" ]; do
  source_dir="$(cd -P "$(dirname "$source_path")" && pwd)"
  source_path="$(readlink "$source_path")"
  case "$source_path" in
    /*) ;;
    *) source_path="$source_dir/$source_path" ;;
  esac
done

plugin_root="$(cd -P "$(dirname "$source_path")/.." && pwd)"

exec "$plugin_root/node_modules/.bin/tsx" "$plugin_root/src/cli/index.ts" "$@"
